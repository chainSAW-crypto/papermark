# ============================================================================
# Papermark — Coolify self-host environment
# Fill in every REQUIRED value. OPTIONAL sections enable extra features and
# can be left blank; the app degrades gracefully (feature silently disabled)
# rather than crashing. SKIPPED FOR V1 sections are deliberately left out of
# this deploy per the agreed plan — revisit later if you want them.
# ============================================================================

# ---- Core app ----
NODE_ENV=production
NEXTAUTH_SECRET=                      # REQUIRED — generate: openssl rand -base64 32
NEXTAUTH_URL=https://papermark.yourdomain.com
NEXT_PUBLIC_BASE_URL=https://papermark.yourdomain.com
NEXT_PUBLIC_MARKETING_URL=https://papermark.yourdomain.com
NEXT_PUBLIC_APP_BASE_HOST=papermark.yourdomain.com   # bare hostname, no protocol

# Internal service-to-service auth (server calls its own API routes, e.g.
# S3 presign, notification triggers, cron-invoked callbacks). Any strong
# random string — must match across every replica of the app.
INTERNAL_API_KEY=                     # REQUIRED — generate: openssl rand -hex 32

# Encrypts document access passwords at rest. Changing this after documents
# have passwords set will break decryption of existing ones — set once.
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=   # REQUIRED — generate: openssl rand -base64 32

# HMAC secret for viewer verification-link checksums.
NEXT_PRIVATE_VERIFICATION_SECRET=     # REQUIRED — generate: openssl rand -base64 32

# On-demand ISR revalidation token (arbitrary secret, must just be non-empty).
REVALIDATE_TOKEN=                     # REQUIRED — generate: openssl rand -hex 16

# ---- Database (Coolify-managed Postgres) ----
# Same connection reused for both; only split these if you put pgbouncer in
# front of Postgres (then POSTGRES_PRISMA_URL goes through the pooler and
# _NON_POOLING connects directly, since Prisma migrations need a direct conn).
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST:5432/papermark?schema=public
POSTGRES_PRISMA_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST:5432/papermark?schema=public

# ---- Storage: S3-compatible (MinIO on Coolify) ----
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_REGION=us-east-1
NEXT_PRIVATE_UPLOAD_ENDPOINT=https://minio.yourdomain.com   # MinIO's Coolify FQDN
NEXT_PRIVATE_UPLOAD_BUCKET=papermark-docs
NEXT_PRIVATE_ARCHIVE_BUCKET=papermark-archive               # separate bucket, create both in MinIO
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=
# MUST be left empty for MinIO. When set, get-presigned-get-url.ts treats it as
# a CloudFront distribution and signs URLs with NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_ID
# / _KEY_CONTENTS — which are blank here, producing unusable URLs and breaking
# document viewing. Empty makes it fall through to normal S3 presigned URLs,
# which is what MinIO needs.
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST=
# Distribution key vars below are CloudFront-signing only — N/A for MinIO, leave empty.

# ---- Redis (Coolify Redis + serverless-redis-http sidecar, see deploy/redis-compose.yaml) ----
UPSTASH_REDIS_REST_URL=http://srh.yourdomain.com          # or internal Coolify service DNS
UPSTASH_REDIS_REST_TOKEN=                                  # SRH_TOKEN you set on the sidecar
UPSTASH_REDIS_REST_LOCKER_URL=http://srh.yourdomain.com    # can reuse the same SRH+Redis
UPSTASH_REDIS_REST_LOCKER_TOKEN=

# ---- Email (Resend — required, EmailProvider magic-link login depends on it) ----
RESEND_API_KEY=

# ---- Background jobs (Trigger.dev Cloud) ----
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# ---- Google OAuth (optional extra login method) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI features (optional — Ask AI / chat with document) ----
OPENAI_API_KEY=

# ============================================================================
# SKIPPED FOR V1 (per agreed scope) — leave blank, revisit later:
#   TINYBIRD_TOKEN / TINYBIRD_BASE_URL        (page-view analytics, needs Tinybird cloud)
#   QSTASH_TOKEN / QSTASH_CURRENT_SIGNING_KEY / QSTASH_NEXT_SIGNING_KEY
#                                              (signs the 4 app/api/cron/* routes)
#   STRIPE_SECRET_KEY / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (billing/paid plans)
#   HANKO_API_KEY / NEXT_PUBLIC_HANKO_TENANT_ID (passkey signup)
#   PROJECT_ID_VERCEL / TEAM_ID_VERCEL / AUTH_BEARER_TOKEN
#                                              (custom domains via Vercel's Domains API —
#                                               only works when actually hosted on Vercel)
#   EDGE_CONFIG                               (Vercel Edge Config — blacklist/feature flags)
# ============================================================================
